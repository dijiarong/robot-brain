# Edge / laptop: lean robot-brain talking to Orin Nav2 over ROS 2.
# Same Wi-Fi + same ROS_DOMAIN_ID as the Navigation container/host.
#
# Usage:
#   set -a && source config/profiles/edge-brain-lean.env && set +a
#   python -m examples.run_service
#   # or: ./scripts/run_with_profile.sh edge-brain-lean python -m examples.run_service
#
# Verify (read-only):
#   ./scripts/run_with_profile.sh edge-brain-lean python scripts/verify_nav2_provider.py
# Control surface (status / cancel / re-goal):
#   ./scripts/run_with_profile.sh edge-brain-lean \
#     python scripts/verify_nav2_control_surface.py --read-only
#
# Live near-field goal (explicit):
#   ./scripts/run_with_profile.sh edge-brain-lean \
#     python scripts/verify_nav2_control_surface.py --live-forward 0.3

RDB_ROBOT=mock
RDB_NAVIGATION_BACKEND=nav2
RDB_NAV2_ACTION_NAME=/navigate_to_pose
RDB_NAV2_ODOM_TOPIC=/odom
RDB_NAV2_GOAL_FRAME=odom
RDB_NAV2_MAP_FRAME=map
RDB_NAV2_BASE_FRAME=base_link

# No second Go2 WebRTC / ffmpeg on the edge box for Mid-360 nav.
RDB_UNITREE_VIDEO_RELAY=false
RDB_UNITREE_AUDIO_RELAY=false
RDB_UNITREE_LIDAR_STREAM=false
RDB_UNITREE_GATEWAY=false
RDB_UNITREE_MEDIA_ON_DEMAND=true
RDB_VLM_ENABLED=false
RDB_UNITREE_DRY_RUN=true
RDB_UNITREE_ENABLE_MOTION=false

# Keep cancel / status / replan available (do not strip control APIs).
# Operator may cancel anytime; network drops should leave Nav2 goal recoverable
# via get_state + cancel + set_*_goal again (see verify_nav2_control_surface.py).

# Match Orin ROS domain if you changed it (Navigation default is often 0).
# ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
