# Orin onboard: Mid-360 Navigation stack only.
# Do NOT start robot-brain / Go2 WebRTC / ffmpeg on this profile.
#
# Usage on Orin:
#   cd ~/work/Navigation && ./scripts/start_nav_stack.sh
#   # optional baseline:
#   # (from robot-brain checkout) ./scripts/collect_orin_nav_baseline.sh
#
# Explicitly refuse brain media/control stacks if someone sources this by mistake:
RDB_ROBOT=mock
RDB_NAVIGATION_BACKEND=fake
RDB_UNITREE_VIDEO_RELAY=false
RDB_UNITREE_AUDIO_RELAY=false
RDB_UNITREE_LIDAR_STREAM=false
RDB_VLM_ENABLED=false
RDB_UNITREE_GATEWAY=false
RDB_UNITREE_MEDIA_ON_DEMAND=true
